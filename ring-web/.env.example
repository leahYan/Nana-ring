# Copy to .env.local and fill in your values.
# The Supabase values are public by design — RLS is the security gate.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# FastAPI base URL — used only for CSV export
VITE_API_BASE_URL=https://<your-vps-domain>/api/v1
